# Frontend env schema. Copy to `.env.local` (gitignored) and fill in.
# CRA loads `.env.local` on both `npm start` and `npm run build`.
# In production on Vercel, set these as Project Environment Variables
# in the Vercel dashboard instead of using a file.
#
# Note: every REACT_APP_* variable is embedded in the built JS bundle
# and is therefore visible to anyone using the deployed site. Do not
# put values here that you treat as server-side secrets.

# Pinata IPFS pinning API.
REACT_APP_PINATA_API_URL=https://api.pinata.cloud/pinning

# Pinata JWT — required for `pinJSONToIPFS` calls from the browser.
REACT_APP_PINATA_JWT=

# Sepolia VinCidRegistry address (chainId 11155111) — this is the UUPS
# PROXY address (ADR 0028), set once by `npm run deploy:sepolia` (bootstrap)
# and stable across every later `npm run upgrade:sepolia`. Set in Vercel UI
# for production. Leave empty locally unless `npm start` should hit Sepolia.
REACT_APP_SMART_CONTRACT_ADDRESS=

# Localhost (Hardhat) VinCidRegistry proxy address (chainId 31337).
# Auto-populated by `npm run deploy:local` from the repo root; unaffected by
# `npm run upgrade:local`.
REACT_APP_SMART_CONTRACT_ADDRESS_LOCAL=

# Block the VinCidRegistry proxy was deployed at (not affected by upgrades —
# CidStored is always emitted at the proxy address). Optional — bounds the
# event scan used to reconstruct a VIN's transaction history; falls back to a
# full scan from block 0 when unset. Auto-populated alongside the addresses
# above.
REACT_APP_SMART_CONTRACT_DEPLOY_BLOCK=
REACT_APP_SMART_CONTRACT_DEPLOY_BLOCK_LOCAL=
